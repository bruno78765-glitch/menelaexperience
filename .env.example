# Configuração do Supabase para Asterion (@mundoasterion)
# Se estas variáveis ficarem vazias ou se o arquivo .env não existir,
# o jogo roda automaticamente no Modo Offline/Demo com seed/moradores.json e localStorage.
# NUNCA coloque a chave service_role no front-end!

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
