{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "server/**/*.ts",
    "src/lib/pricing.ts",
    "src/lib/pricing.test.ts",
    "src/lib/csv.ts",
    "src/lib/csv.test.ts",
    "src/lib/types.ts"
  ]
}
